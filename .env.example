# TradeumDiary local environment
# Copy this file to .env before starting Docker Compose.

POSTGRES_PASSWORD=replace-with-a-long-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-different-32-character-secret

# Public URL used in password reset links.
APP_URL=http://localhost:3000

# Optional in local development. Required when NODE_ENV=production.
RESEND_API_KEY=
EMAIL_FROM=TradeumDiary <security@example.com>

# YooKassa server credentials. Never expose these through VITE_* variables.
BILLING_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=

# Vite uses the same-origin Nginx/Vite proxy by default.
VITE_API_URL=/api
