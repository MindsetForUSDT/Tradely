```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.css.map

# Cache directories
.cache/
.node_cache/

# Environment variables
.env
.env.local
.env.*

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
*.bak
```