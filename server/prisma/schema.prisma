generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                      String               @id @default(uuid())
  email                   String               @unique
  username                String?              @unique
  hashed_password         String?
  avatar_url              String?
  subscription_tier       String               @default("free")
  subscription_expires_at DateTime?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  analytics               DailyAnalytics[]
  tags                    Tag[]
  trades                  Trade[]
  wallets                 Wallet[]
  sessions                AuthSession[]
  password_reset_tokens   PasswordResetToken[]
  audit_logs              AuditLog[]
  risk_limits             RiskLimit?
  goals                   Goal[]

  @@map("profiles")
}

model RiskLimit {
  id                    String   @id @default(uuid())
  user_id               String   @unique
  daily_loss_limit      Decimal  @default(0) @db.Decimal(20, 2)
  weekly_loss_limit     Decimal  @default(0) @db.Decimal(20, 2)
  position_size_percent Decimal  @default(2) @db.Decimal(8, 2)
  max_leverage          Decimal  @default(1) @db.Decimal(8, 2)
  alert_enabled         Boolean  @default(true)
  alert_email           String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  user                  Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("risk_limits")
}

model Goal {
  id                 String    @id @default(uuid())
  user_id            String
  title              String
  target_description String
  progress           Int       @default(0)
  status             String    @default("active")
  due_at             DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user               Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status, created_at])
  @@map("goals")
}

model AuthSession {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  revoked_at   DateTime?
  last_used_at DateTime  @default(now())
  ip_address   String?
  user_agent   String?
  persistent   Boolean   @default(false)
  created_at   DateTime  @default(now())
  user         Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  ip_address String?
  user_agent String?
  metadata   String?
  created_at DateTime @default(now())
  user       Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([action, created_at])
  @@map("audit_logs")
}

model Wallet {
  id                    String    @id @default(uuid())
  user_id               String
  address               String
  chain                 String
  label                 String?
  encrypted_credentials String?
  credentials_iv        String?
  credentials_tag       String?
  web3_provider         String?
  cex_provider          String?
  processing_status     String    @default("pending")
  last_synced_at        DateTime?
  last_processed_block  Int?
  error_message         String?
  settings              String?
  import_from_date      DateTime?
  added_at              DateTime  @default(now())
  trades                Trade[]
  user                  Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Один CEX провайдер на пользователя
  @@unique([user_id, cex_provider], name: "unique_user_cex")
  // Один адрес на пользователя для Web3 и брокеров
  @@unique([user_id, address], name: "unique_user_address")
  @@map("wallets")
}

model Trade {
  id             String     @id @default(uuid())
  user_id        String
  wallet_id      String?
  tx_hash        String?
  timestamp      DateTime   @default(now())
  block_number   Int?
  symbol         String
  side           String
  amount         Decimal    @default(0) @db.Decimal(20, 8)
  price_usd      Decimal    @default(0) @db.Decimal(20, 8)
  value_usd      Decimal    @default(0) @db.Decimal(20, 8)
  fee_usd        Decimal    @default(0) @db.Decimal(20, 8)
  pnl_realized   Decimal    @default(0) @db.Decimal(20, 8)
  pnl_unrealized Decimal    @default(0) @db.Decimal(20, 8)
  status         String     @default("completed")
  exchange       String?
  import_source  String     @default("manual")
  raw_data       String?
  created_at     DateTime   @default(now())
  tags           TradeTag[]
  user           Profile    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet         Wallet?    @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tx_hash], name: "unique_user_tx")
  @@index([user_id, wallet_id])
  @@index([user_id, timestamp])
  @@map("trades")
}

model Tag {
  id         String     @id @default(uuid())
  user_id    String
  name       String
  color      String     @default("#00FFA3")
  created_at DateTime   @default(now())
  user       Profile    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tradeTags  TradeTag[]

  @@unique([user_id, name])
  @@map("tags")
}

model TradeTag {
  id       String @id @default(uuid())
  trade_id String
  tag_id   String
  tag      Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  trade    Trade  @relation(fields: [trade_id], references: [id], onDelete: Cascade)

  @@unique([trade_id, tag_id])
  @@map("trade_tags")
}

model DailyAnalytics {
  id               String   @id @default(uuid())
  user_id          String
  date             DateTime @db.Date
  total_trades     Int      @default(0)
  winning_trades   Int      @default(0)
  losing_trades    Int      @default(0)
  realized_pnl_usd Decimal  @default(0) @db.Decimal(20, 8)
  volume_usd       Decimal  @default(0) @db.Decimal(20, 8)
  avg_trade_size   Decimal  @default(0) @db.Decimal(20, 8)
  max_drawdown     Decimal  @default(0) @db.Decimal(20, 8)
  sharpe_ratio     Decimal  @default(0) @db.Decimal(20, 8)
  win_rate         Decimal  @default(0) @db.Decimal(20, 8)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user             Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@map("daily_analytics")
}
